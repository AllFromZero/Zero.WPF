<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Zero.WPF.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Zero.WPF;component/Themes/ZeroDefault.xaml"/>
        <ResourceDictionary Source="/Zero.WPF;component/Themes/IconCodes.xaml"/>
        <ResourceDictionary Source="/Zero.WPF;component/Resources/Styles/TextBlockStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:ZeroDateRangePicker}">
        <Setter Property="FontFamily" Value="{StaticResource Zero.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Zero.FontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource Zero.Input.Foreground}"/>
        <Setter Property="Background" Value="{StaticResource Zero.Input.Background}"/>
        <Setter Property="Padding" Value="{StaticResource Zero.Padding}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource ResourceKey=Zero.CornerRadius}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Zero.Static.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Zero.Input.BorderThickness}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="StartTime" Value="{Binding QueryStartTime}"/>
        <Setter Property="EndTime" Value="{Binding QueryEndTime}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ZeroDateRangePicker}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <local:ZeroDatePicker Grid.Column="0" SelectedDate="{Binding StartTime, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"/>
                        <TextBlock Grid.Column="1" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center">-</TextBlock>
                        <local:ZeroDatePicker Grid.Column="2" SelectedDate="{Binding EndTime, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>