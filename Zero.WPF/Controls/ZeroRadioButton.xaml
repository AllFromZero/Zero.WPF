<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Zero.WPF.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Zero.WPF;component/Themes/ZeroDefault.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" StrokeDashArray="1 2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" StrokeThickness="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OptionMarkFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="14,0,0,0" StrokeDashArray="1 2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" StrokeThickness="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="RadioButton.Static.Glyph" Color="#FF212121"/>
    <SolidColorBrush x:Key="RadioButton.MouseOver.Glyph" Color="#FF212121"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Glyph" Color="#FF212121"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Glyph" Color="#FF707070"/>
    <Style TargetType="{x:Type local:ZeroRadioButton}">
        <Setter Property="FontFamily" Value="{StaticResource Zero.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Zero.FontSize}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Zero.Static.Border}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="MaskBackground" Value="{StaticResource Zero.MaskBackground}"/>
        <Setter Property="IsCheckedForeground" Value="{StaticResource Zero.CheckedForeground}"/>
        <Setter Property="IsCheckedBackground" Value="{StaticResource Zero.CheckedBackground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="{StaticResource Zero.Padding}"/>
        <Setter Property="Margin" Value="{StaticResource Zero.Margin}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ZeroRadioButton}">
                    <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="outBorder" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{Binding Path=CornerRadius,RelativeSource={RelativeSource TemplatedParent}}">
                            <DockPanel LastChildFill="True" Margin="{TemplateBinding Padding}">
                                <Border x:Name="iconBorder" 
                                        DockPanel.Dock="{TemplateBinding IconAlignment}" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="100" 
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                        Margin="0,0,2,0" 
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Visibility="Collapsed">
                                    <Grid x:Name="markGrid" Margin="2">
                                        <Ellipse x:Name="optionMark" Fill="{StaticResource RadioButton.Static.Glyph}" MinWidth="6" MinHeight="6" Opacity="0"/>
                                    </Grid>
                                </Border>
                                <Border DockPanel.Dock="{TemplateBinding IconAlignment}" Width="{TemplateBinding IconWidth}" Height="{TemplateBinding IconHeight}">
                                    <ContentPresenter x:Name="contentIcon" Content="{TemplateBinding Icon}" Margin="{TemplateBinding IconMargin}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </Border>
                                <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="maskBorder" Grid.ColumnSpan="2"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="Transparent"
                                Margin="0"
                                BorderBrush="Transparent"
                                BorderThickness="0">
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasContent" Value="true"/>
                                <Condition Property="Visibility" SourceName="iconBorder" Value="Visible"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource OptionMarkFocusVisual}"/>
                            <!--<Setter Property="Padding" Value="4,-1,0,0"/>-->
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="iconBorder" Value="{StaticResource Zero.MouseOver.Background}"/>
                            <Setter Property="BorderBrush" TargetName="iconBorder" Value="{StaticResource Zero.MouseOver.Border}"/>
                            <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource RadioButton.MouseOver.Glyph}"/>
                            <Setter Property="Background" TargetName="maskBorder" Value="{Binding Path=MaskBackground,RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" TargetName="iconBorder" Value="{StaticResource Zero.Disabled.Background}"/>
                            <Setter Property="BorderBrush" TargetName="iconBorder" Value="{StaticResource Zero.Disabled.Border}"/>
                            <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource RadioButton.Disabled.Glyph}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="iconBorder" Value="{StaticResource Zero.Pressed.Background}"/>
                            <Setter Property="BorderBrush" TargetName="iconBorder" Value="{StaticResource Zero.Pressed.Border}"/>
                            <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource RadioButton.Pressed.Glyph}"/>
                            <Setter Property="Margin" TargetName="maskBorder" Value="{Binding Path=Padding,RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter Property="Opacity" TargetName="optionMark" Value="1"/>
                            <Setter Property="Background" TargetName="outBorder" Value="{Binding Path=IsCheckedBackground,RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter Property="TextBlock.Foreground" TargetName="outBorder" Value="{Binding Path=IsCheckedForeground,RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter Property="TextBlock.FontWeight" TargetName="outBorder" Value="{Binding Path=IsCheckedFontWeight,RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter Property="Content" TargetName="contentIcon" Value="{Binding Path=IsCheckedIcon,RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter Property="Background" TargetName="iconBorder" Value="{Binding Path=Background,RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter Property="BorderBrush" TargetName="iconBorder" Value="{Binding Path=BorderBrush,RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter Property="BorderThickness" TargetName="iconBorder" Value="{Binding Path=BorderThickness,RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter Property="Opacity" TargetName="optionMark" Value="0.56"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter Property="Visibility" TargetName="iconBorder" Value="Visible"/>
                            <Setter Property="Margin" TargetName="contentIcon" Value="0"/>
                            <Setter Property="Visibility" TargetName="contentIcon" Value="Collapsed"/>
                            <Setter Property="Visibility" TargetName="maskBorder" Value="Collapsed"/>
                            <Setter Property="Background" TargetName="outBorder" Value="Transparent"/>
                            <Setter Property="BorderBrush" TargetName="outBorder" Value="Transparent"/>
                            <Setter Property="BorderThickness" TargetName="outBorder" Value="0"/>
                            <Setter Property="TextBlock.Foreground" TargetName="outBorder" Value="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="">
                            <Setter Property="Visibility" TargetName="iconBorder" Value="Visible"/>
                            <Setter Property="Margin" TargetName="contentIcon" Value="0"/>
                            <Setter Property="Visibility" TargetName="contentIcon" Value="Collapsed"/>
                            <Setter Property="Visibility" TargetName="maskBorder" Value="Collapsed"/>
                            <Setter Property="Background" TargetName="outBorder" Value="Transparent"/>
                            <Setter Property="BorderBrush" TargetName="outBorder" Value="Transparent"/>
                            <Setter Property="BorderThickness" TargetName="outBorder" Value="0"/>
                            <Setter Property="TextBlock.Foreground" TargetName="outBorder" Value="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsCheckedIcon" Value="{x:Null}">
                            <Setter Property="Content" TargetName="contentIcon" Value="{Binding Path=Icon,RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsCheckedIcon" Value="">
                            <Setter Property="Content" TargetName="contentIcon" Value="{Binding Path=Icon,RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter Property="Margin" TargetName="contentIcon" Value="0"/>
                        </Trigger>
                        <Trigger Property="Content" Value="">
                            <Setter Property="Margin" TargetName="contentIcon" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>